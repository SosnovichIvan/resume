# Конфигурация production-развёртывания.
# Значения читаются deploy.sh как обычные KEY=VALUE; shell-код не выполняется.

# Публичный домен без протокола и пути.
DOMAIN=resume.example.com

# Email ACME-аккаунта для уведомлений о проблемах с TLS-сертификатами.
ACME_EMAIL=admin@example.com

# HTTPS URL публичного Git-репозитория или SSH URL при заранее настроенном ключе.
REPOSITORY_URL=https://github.com/SosnovichIvan/resume.git
